---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { ui, langs, type Lang } from '../../i18n';
import { episodes, episodeUrl, posts } from '../../lib';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const latest = (await posts(lang)).slice(0, 6);
const other = lang === 'fa' ? 'en' : 'fa';
---
<Base lang={lang} title={t.site} description={t.tagline} alternate={`/${other}/`} nav="home"
  jsonld={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: t.site, url: new URL(`/${lang}/`, Astro.site).href, inLanguage: lang === 'fa' ? 'fa-IR' : 'en' }]}>
  <div class="eyebrow">HOMODYNE · SEASON 01</div>
  <h1>{t.site}</h1>
  <p class="lede">{t.tagline}</p>

  <h2>{t.episodes}</h2>
  <div class="grid">
    {episodes.map((e) => (
      <div class="card">
        <span class="meta">{e.hmd}</span>
        <h3><a href={episodeUrl(e, lang)}>{e[lang].title}</a></h3>
      </div>
    ))}
  </div>

  {latest.length > 0 && <>
    <h2>{t.latest}</h2>
    <div class="grid">{latest.map((p) => <PostCard post={p} />)}</div>
    <p><a href={`/${lang}/blog/`}>{t.blog} →</a></p>
  </>}
</Base>

---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { ui, langs, type Lang } from '../../../i18n';
import { posts } from '../../../lib';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const list = await posts(lang);
const other = lang === 'fa' ? 'en' : 'fa';
---
<Base lang={lang} title={t.blog} description={t.tagline} alternate={`/${other}/blog/`} nav="blog">
  <h1>{t.blog}</h1>
  <p class="lede">{t.tagline} <a href={`/${lang}/rss.xml`}>{t.rss}</a></p>
  <div class="grid">{list.map((p) => <PostCard post={p} />)}</div>
</Base>
